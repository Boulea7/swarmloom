{
  "name": "@swarmloom/formats",
  "version": "0.1.0",
  "description": "SwarmLoom format detection and lazy adapter registry.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@swarmloom/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boulea7/swarmloom.git",
    "directory": "packages/formats"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@swarmloom/core": "workspace:*",
    "@swarmloom/snapshot-dom": "workspace:*",
    "@swarmloom/adapter-markdown": "workspace:*",
    "@swarmloom/adapter-html": "workspace:*",
    "@swarmloom/adapter-docx": "workspace:*",
    "@swarmloom/adapter-doc": "workspace:*",
    "@swarmloom/adapter-pdf": "workspace:*",
    "@swarmloom/adapter-svg": "workspace:*",
    "@swarmloom/adapter-office": "workspace:*",
    "@swarmloom/adapter-code": "workspace:*",
    "@swarmloom/adapter-image": "workspace:*",
    "@swarmloom/adapter-three": "workspace:*"
  }
}
