{
  "name": "@swarmloom/adapter-office",
  "version": "0.1.0",
  "description": "Office adapter for SwarmLoom: PPTX slides and XLSX/XLS/CSV/ODS sheets.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@swarmloom/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boulea7/swarmloom.git",
    "directory": "packages/adapter-office"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@swarmloom/core": "workspace:*",
    "fflate": "^0.8.3"
  }
}
