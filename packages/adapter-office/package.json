{
  "name": "@swarmloom/adapter-office",
  "version": "0.1.0",
  "description": "Office adapters for SwarmLoom: PPTX slides and XLSX/ODS/CSV/TSV sheets.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@swarmloom/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./slides": {
      "@swarmloom/source": "./src/slides.ts",
      "types": "./dist/slides.d.ts",
      "import": "./dist/slides.js"
    },
    "./sheet": {
      "@swarmloom/source": "./src/sheet.ts",
      "types": "./dist/sheet.d.ts",
      "import": "./dist/sheet.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boulea7/swarmloom.git",
    "directory": "packages/adapter-office"
  },
  "scripts": {
    "build": "tsup src/index.ts src/slides.ts src/sheet.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@swarmloom/core": "workspace:*",
    "fflate": "^0.8.3"
  }
}
