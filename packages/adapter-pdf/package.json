{
  "name": "@swarmloom/adapter-pdf",
  "version": "0.1.0",
  "description": "PDF adapter for SwarmLoom: pdf.js page bitmaps revealed region by region (typed text lines, swept figures, drawn rules).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@swarmloom/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boulea7/swarmloom.git",
    "directory": "packages/adapter-pdf"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p .",
    "sample": "node ../../examples/pdf/generate.mjs"
  },
  "dependencies": {
    "@swarmloom/core": "workspace:*",
    "pdfjs-dist": "6.5.438"
  }
}
