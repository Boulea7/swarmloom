{
  "name": "@swarmloom/adapter-markdown",
  "version": "0.1.0",
  "description": "Markdown (GFM) adapter for SwarmLoom: themed HTML rendered in a sandbox, then snapshotted.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@swarmloom/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boulea7/swarmloom.git",
    "directory": "packages/adapter-markdown"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@swarmloom/adapter-code": "workspace:*",
    "@swarmloom/core": "workspace:*",
    "@swarmloom/snapshot-dom": "workspace:*",
    "dompurify": "^3.4.17",
    "katex": "^0.19.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "jsdom": "^31.0.0"
  }
}
