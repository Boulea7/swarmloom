{
  "name": "@swarmloom/core",
  "version": "0.1.0",
  "description": "SwarmLoom engine: planner, choreographies, isolated stage, overlay, sound, player and toolbar UI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@swarmloom/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "@swarmloom/source": "./src/animation-starts.ts",
      "types": "./dist/animation-starts.d.ts",
      "import": "./dist/animation-starts.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boulea7/swarmloom.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsup src/index.ts src/animation-starts.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p ."
  }
}
