{
  "name": "@swarmloom/adapter-doc",
  "version": "0.1.0",
  "description": "Legacy DOC adapter for SwarmLoom: Word 97-2003 binary files parsed in pure JavaScript into page sheets (text mode by default), then snapshotted.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@swarmloom/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boulea7/swarmloom.git",
    "directory": "packages/adapter-doc"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@swarmloom/adapter-docx": "workspace:*",
    "@swarmloom/core": "workspace:*",
    "@swarmloom/snapshot-dom": "workspace:*",
    "cfb": "1.2.2"
  }
}
