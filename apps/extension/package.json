{
  "name": "@swarmloom/extension",
  "version": "0.1.0",
  "private": true,
  "description": "SwarmLoom browser extension for Chrome, Edge, Firefox and Safari.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs --target all",
    "build:e2e": "node scripts/build.mjs --target chrome --e2e",
    "build:amo-source": "node scripts/amo-source.mjs",
    "check:package": "node scripts/audit.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test:e2e": "node scripts/build.mjs --target chrome --e2e && node --test test/e2e/extension.e2e.mjs",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "package:safari": "bash scripts/safari-package.sh"
  },
  "dependencies": {
    "@swarmloom/core": "workspace:*",
    "@swarmloom/element": "workspace:*",
    "@swarmloom/formats": "workspace:*",
    "@swarmloom/snapshot-dom": "workspace:*"
  },
  "devDependencies": {
    "@swarmloom/studio": "workspace:*",
    "esbuild": "^0.28.2",
    "web-ext": "10.8.0"
  }
}
