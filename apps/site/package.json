{
  "name": "@swarmloom/site",
  "version": "0.1.0",
  "private": true,
  "description": "SwarmLoom official website: bilingual product page with a live hero built by the swarm.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "node scripts/fetch-media.mjs && vite build --configLoader runner",
    "build:offline": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "fetch-media": "node scripts/fetch-media.mjs",
    "audit": "node scripts/audit.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@swarmloom/element": "workspace:*"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@phosphor-icons/core": "2.1.1",
    "esbuild": "^0.28.2"
  }
}
