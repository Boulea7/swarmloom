{
  "name": "@swarmloom/studio",
  "version": "0.1.0",
  "private": true,
  "description": "SwarmLoom Studio: a PWA to open any file or URL and watch the swarm build it, then export a video.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode extension",
    "build:web": "vite build",
    "build:extension": "vite build --mode extension",
    "preview": "vite preview",
    "screens": "node scripts/screens.mjs",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.sw.json"
  },
  "dependencies": {
    "@swarmloom/core": "workspace:*",
    "@swarmloom/export": "workspace:*",
    "@swarmloom/formats": "workspace:*",
    "uqr": "^0.1.3"
  }
}
