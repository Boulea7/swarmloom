{
  "name": "swarmloom-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "SwarmLoom monorepo: a swarm of cursors rebuilds web pages, documents and models in front of you.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" build",
    "dev:studio": "pnpm --filter @swarmloom/studio dev",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:e2e": "node scripts/e2e.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p . && pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" typecheck",
    "bench": "node scripts/bench.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "build:extension": "node scripts/release/build-extension.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "check:licenses": "node scripts/release/check-licenses.mjs",
    "check:packages": "node scripts/release/check-packages.mjs",
    "check:store": "node scripts/release/check-store.mjs",
    "test:release": "node --test \"scripts/release/test/*.test.mjs\"",
    "typecheck:release": "tsc -p scripts/release"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
