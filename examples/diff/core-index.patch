From d301690ded09fc718db94f2593395b4acfeb7a47 Mon Sep 17 00:00:00 2001
From: boulea7
Date: Tue, 10 Nov 2026 17:24:46 +0800
Subject: [PATCH] chore(adapters): drop unused snapshot-dom dependency from svg
 and image adapters

Both adapters now produce layers directly and no longer need the DOM snapshot package.
---
 packages/adapter-image/package.json | 3 +--
 packages/adapter-svg/package.json   | 3 +--
 pnpm-lock.yaml                      | 6 ------
 3 files changed, 2 insertions(+), 10 deletions(-)

diff --git a/packages/adapter-image/package.json b/packages/adapter-image/package.json
index c034e52..3b7a96f 100644
--- a/packages/adapter-image/package.json
+++ b/packages/adapter-image/package.json
@@ -27,7 +27,6 @@
     "typecheck": "tsc --noEmit -p ."
   },
   "dependencies": {
-    "@swarmloom/core": "workspace:*",
-    "@swarmloom/snapshot-dom": "workspace:*"
+    "@swarmloom/core": "workspace:*"
   }
 }
diff --git a/packages/adapter-svg/package.json b/packages/adapter-svg/package.json
index bf67b13..a93d335 100644
--- a/packages/adapter-svg/package.json
+++ b/packages/adapter-svg/package.json
@@ -27,7 +27,6 @@
     "typecheck": "tsc --noEmit -p ."
   },
   "dependencies": {
-    "@swarmloom/core": "workspace:*",
-    "@swarmloom/snapshot-dom": "workspace:*"
